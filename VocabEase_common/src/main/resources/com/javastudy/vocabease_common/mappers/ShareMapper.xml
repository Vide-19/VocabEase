<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javastudy.vocabease_common.mappers.ShareMapper">

	<!--实体映射-->
	<resultMap id="base_result_map" type="com.javastudy.vocabease_common.entity.po.Share">
		<!--笔记id-->
		<id column="share_id" property="shareId"  />
		<!--标题-->
		<result column="title" property="title"  />
		<!--内容-->
		<result column="content" property="content"  />
		<!--笔记类别 0无封面 1横幅 2小图标-->
		<result column="cover_type" property="coverType"  />
		<!--封面路径-->
		<result column="cover_path" property="coverPath"  />
		<!--创建时间-->
		<result column="create_time" property="createTime"  />
		<!--状态 0未发布 1已发布-->
		<result column="status" property="status"  />
		<!--作者id-->
		<result column="creater_id" property="createrId"  />
		<result column="user_name" property="createrName" />
		<result column="nick_name" property="nickName" />
		<!--浏览量-->
		<result column="read_count" property="readCount"  />
		<!--收藏数-->
		<result column="collect_count" property="collectCount"  />
		<!--发布类型 0内部 1外部-->
		<result column="post_type" property="postType"  />
		<result column="relate_type" property="relateType" />
		<result column="relate_id" property="relateId" />
		<result column="is_collect" property="isCollect" javaType="java.lang.Boolean"/>
		<result column="collect_id" property="collectId" />
		<result column="collect_time" property="collectTime" />
	</resultMap>


	<!-- 通用查询结果列-->
	<sql id="base_column_list">
        s.share_id,s.title,s.cover_type,s.cover_path,
		 s.create_time,s.status,s.creater_id,s.read_count,s.collect_count,
		 s.post_type, u.user_name as user_name, s.relate_type, s.relate_id,
		  CASE WHEN ac.collect_id IS NOT NULL THEN 1 ELSE 0 END as is_collect, ac.collect_id, ac.collect_time
    </sql>

	<sql id="base_condition_filed">
        <if test="query.shareId != null">
            and s.share_id = #{query.shareId}
        </if>
        <if test="query.title != null and query.title!=''">
            and s.title = #{query.title}
        </if>
        <if test="query.content != null and query.content!=''">
            and s.content = #{query.content}
        </if>
        <if test="query.coverType != null">
            and s.cover_type = #{query.coverType}
        </if>
        <if test="query.coverPath != null and query.coverPath!=''">
            and s.cover_path = #{query.coverPath}
        </if>
        <if test="query.createTime != null and query.createTime!=''">
            <![CDATA[ and  s.create_time=str_to_date(#{query.createTime}, '%Y-%m-%d') ]]>
        </if>
        <if test="query.status != null">
            and s.status = #{query.status}
        </if>
        <if test="query.createrId != null and query.createrId!=''">
            and s.creater_id = #{query.createrId}
        </if>
        <if test="query.readCount != null">
            and s.read_count = #{query.readCount}
        </if>
        <if test="query.collectCount != null">
            and s.collect_count = #{query.collectCount}
        </if>
        <if test="query.postType != null">
            and s.post_type = #{query.postType}
        </if>
        <if test="query.relateType != null">
            and s.relate_type = #{query.relateType}
        </if>
        <if test="query.relateId != null">
            and s.relate_id = #{query.relateId}
        </if>
    </sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
        <where>
            <include refid="base_condition_filed"/>
            <if test="query.titleFuzzy!= null  and query.titleFuzzy!=''">
                and s.title like concat('%', #{query.titleFuzzy}, '%')
            </if>
            <if test="query.contentFuzzy!= null  and query.contentFuzzy!=''">
                and s.content like concat('%', #{query.contentFuzzy}, '%')
            </if>
            <if test="query.coverPathFuzzy!= null  and query.coverPathFuzzy!=''">
                and s.cover_path like concat('%', #{query.coverPathFuzzy}, '%')
            </if>
            <if test="query.createTimeStart!= null and query.createTimeStart!=''">
                <![CDATA[ and  s.create_time>=str_to_date(#{query.createTimeStart}, '%Y-%m-%d') ]]>
            </if>
            <if test="query.createTimeEnd!= null and query.createTimeEnd!=''">
                <![CDATA[ and  s.create_time< date_sub(str_to_date(#{query.createTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
            </if>
            <if test="query.createrIdFuzzy!= null  and query.createrIdFuzzy!=''">
                and s.creater_id like concat('%', #{query.createrIdFuzzy}, '%')
            </if>
            <if test="query.shareIds!=null and query.shareIds.length>0">
                and s.share_id in (<foreach collection="query.shareIds" separator="," item="item">#{item}</foreach> )
            </if>
            <if test="query.nextType!=null and query.nextType==1 and query.currentId!=null">
                <![CDATA[ and s.share_id<#{query.currentId} order by s.share_id desc ]]>
            </if>
            <if test="query.nextType!=null and query.nextType==-1 and query.currentId!=null">
                <![CDATA[ and s.share_id>#{query.currentId} order by s.share_id asc ]]>
            </if>
            <if test="query.statusList != null and query.statusList.size > 0">
                AND s.status IN
                <foreach item="item" index="index" collection="query.statusList" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
        </where>
    </sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map">
		SELECT
		s.share_id, s.title, s.cover_type, s.cover_path,
		s.create_time, s.status, s.creater_id, s.read_count, s.collect_count,
		s.post_type, u.user_name as user_name, s.relate_type, s.relate_id,
		<!-- 🆕 核心修复：动态判断是否收藏，不再直接查询 ac.user_id -->
		CASE
		WHEN ac.collect_id IS NOT NULL
		AND ac.user_id = #{query.userId}
		THEN 1
		ELSE 0
		END as is_collect,
		ac.collect_id,
		ac.collect_time,
		a.nick_name
		<!-- 如果需要查询内容，且条件成立 -->
		<if test="query.isQueryContent">, s.content</if>
		FROM share s
		LEFT JOIN account u on s.creater_id = u.user_id
		LEFT JOIN app_account a on s.creater_id = a.user_id
		<!-- 🔗 关联收藏表：通过 share_id 关联 object_id，并过滤类型和用户ID -->
		LEFT JOIN app_collect ac ON s.share_id = ac.object_id
		AND ac.collect_type = #{query.collectType}
		<include refid="query_condition"/>
		<if test="query.orderBy!=null">
			order by ${query.orderBy}
		</if>
		<if test="query.simplePage!=null">
			limit #{query.simplePage.start},#{query.simplePage.end}
		</if>
	</select>

	<!-- 查询数量-->
	<select id="selectCount" resultType="java.lang.Integer" >
		 SELECT count(1) FROM share s <include refid="query_condition" />
	</select>

