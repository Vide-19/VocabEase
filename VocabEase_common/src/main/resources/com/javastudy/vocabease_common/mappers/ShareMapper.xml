	<!-- 根据PrimaryKey获取对象-->
	<select id="selectByShareId" resultMap="base_result_map" >
		SELECT
			s.share_id, s.title, s.cover_type, s.cover_path,
			s.create_time, s.status, s.creater_id, s.read_count, s.collect_count,
			s.post_type, u.user_name, s.relate_type, s.relate_id,
			s.content, a.nick_name
		FROM share s
				 LEFT JOIN account u ON s.creater_id = u.user_id
				 LEFT JOIN app_account a ON s.creater_id = a.user_id
		WHERE s.share_id = #{shareId}
    </select>

	<select id="showShareNext" resultMap="base_result_map">
		select * from share
		<include refid="query_condition"/>
		limit 0,1
	</select>

	<update id="updateCount">
		update share
		<set>
			<if test="readCount!=null">
				read_count = read_count+#{readCount},
			</if>
			<if test="collectCount!=null">
				collect_count = collect_count+#{collectCount},
			</if>
		</set>
		<where>
			share_id=#{shareId}
		</where>
	</update>

	<select id="selectNextCollectedShare" resultMap="base_result_map">
		SELECT
		<include refid="base_column_list"/>
		<if test="query.isQueryContent!=null and query.isQueryContent">
			,s.content
		</if>
		FROM share s
		LEFT JOIN account u ON s.creater_id = u.user_id
		<!-- 关键：内联收藏表 -->
		INNER JOIN app_collect ac ON s.share_id = ac.object_id

		<where>
			<!-- 1. 【核心修正】必须是当前登录用户 (收藏者) 的收藏 -->
			<!-- 使用新加的 userId 字段，而不是 creatorId -->
			AND ac.user_id = #{query.userId}

			AND ac.collect_type = 0

			<!-- 2. 状态正常 -->
			AND s.status = 1

			<!-- 3. 排除当前文章自己 -->
			AND s.share_id != #{query.currentId}

			<!-- 4. 时间逻辑 (保持不变) -->
			<!-- 下一个：找收藏时间更早的 -->
			<if test="query.nextType == 1">
				AND ac.collect_time &lt; (
				SELECT ac2.collect_time
				FROM app_collect ac2
				WHERE ac2.user_id = #{query.userId}
				AND ac2.object_id = #{query.currentId}
				AND ac2.collect_type = 0
				)
			</if>

			<!-- 上一个：找收藏时间更晚的 -->
			<if test="query.nextType == -1">
				AND ac.collect_time &gt; (
				SELECT ac2.collect_time
				FROM app_collect ac2
				WHERE ac2.user_id = #{query.userId}
				AND ac2.object_id = #{query.currentId}
				AND ac2.collect_type = 0
				)
			</if>
		</where>

		<!-- 5. 排序 (保持不变) -->
		<if test="query.nextType == 1">
			ORDER BY ac.collect_time DESC
		</if>
		<if test="query.nextType == -1">
			ORDER BY ac.collect_time ASC
		</if>

		LIMIT 0, 1
	</select>

	<update id="updateReadCount">
		UPDATE share
		SET read_count = read_count + 1
		WHERE share_id = #{shareId}
	</update>
</mapper>