<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javastudy.vocabease_common.mappers.AppUpdateMapper">

	<!--实体映射-->
	<resultMap id="base_result_map" type="com.javastudy.vocabease_common.entity.po.AppUpdate">
		<!--id-->
		<id column="id" property="id"  />
		<!--版本号-->
		<result column="version" property="version"  />
		<!--更新描述-->
		<result column="update_desc" property="updateDesc"  />
		<!--更新类型 0全更新 1局部热更新-->
		<result column="update_type" property="updateType"  />
		<!--状态 0未发布 1灰度发布 2全网发布-->
		<result column="status" property="status"  />
		<!--创建时间-->
		<result column="create_time" property="createTime"  />
		<!--灰度设备id-->
		<result column="grayscale_device" property="grayscaleDevice"  />
	</resultMap>


	<!-- 通用查询结果列-->
	<sql id="base_column_list">
		 a.id,a.version,a.update_desc,a.update_type,a.status,
		 a.create_time,a.grayscale_device
	</sql>

	<sql id="base_condition_filed">
			<if test="query.id != null">
				 and  a.id = #{query.id}
			</if>
			<if test="query.version != null and query.version!=''">
				 and  a.version = #{query.version}
			</if>
			<if test="query.updateDesc != null and query.updateDesc!=''">
				 and  a.update_desc = #{query.updateDesc}
			</if>
			<if test="query.updateType != null">
				 and  a.update_type = #{query.updateType}
			</if>
			<if test="query.status != null">
				 and  a.status = #{query.status}
			</if>
			<if test="query.createTime != null and query.createTime!=''">
				 <![CDATA[ and  a.create_time=str_to_date(#{query.createTime}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.grayscaleDevice != null and query.grayscaleDevice!=''">
				 and  a.grayscale_device = #{query.grayscaleDevice}
			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.versionFuzzy!= null  and query.versionFuzzy!=''">
				 and  a.version like concat('%', #{query.versionFuzzy}, '%')
			</if>
			<if test="query.updateDescFuzzy!= null  and query.updateDescFuzzy!=''">
				 and  a.update_desc like concat('%', #{query.updateDescFuzzy}, '%')
			</if>
			<if test="query.createTimeStart!= null and query.createTimeStart!=''">
				 <![CDATA[ and  a.create_time>=str_to_date(#{query.createTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.createTimeEnd!= null and query.createTimeEnd!=''">
				 <![CDATA[ and  a.create_time< date_sub(str_to_date(#{query.createTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
			<if test="query.grayscaleDeviceFuzzy!= null  and query.grayscaleDeviceFuzzy!=''">
				 and  a.grayscale_device like concat('%', #{query.grayscaleDeviceFuzzy}, '%')
			</if>
	 </where>
	</sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map" >
		 SELECT <include refid="base_column_list" /> FROM app_update a <include refid="query_condition" />
		 <if test="query.orderBy!=null">
			 order by ${query.orderBy}
		 </if>
		 <if test="query.simplePage!=null">
			 limit #{query.simplePage.start},#{query.simplePage.end}
		 </if>
	</select>

	<!-- 查询数量-->
	<select id="selectCount" resultType="java.lang.Integer" >
		 SELECT count(1) FROM app_update a <include refid="query_condition" />
	</select>

	<!-- 插入 （匹配有值的字段）-->
	<insert id="insert" parameterType="com.javastudy.vocabease_common.entity.po.AppUpdate">
		<selectKey keyProperty="bean.id" resultType="Integer" order="AFTER">
			SELECT LAST_INSERT_ID()
		</selectKey>
		 INSERT INTO app_update
		 <trim prefix="(" suffix=")" suffixOverrides="," >
			<if test="bean.version != null">
				 version,
			</if>
			<if test="bean.updateDesc != null">
				 update_desc,
			</if>
			<if test="bean.updateType != null">
				 update_type,
			</if>
			<if test="bean.status != null">
				 status,
			</if>
			<if test="bean.createTime != null">
				 create_time,
			</if>
			<if test="bean.grayscaleDevice != null">
				 grayscale_device,
			</if>
		 </trim>
		 <trim prefix="values (" suffix=")" suffixOverrides="," >
			<if test="bean.version!=null">
				 #{bean.version},
			</if>
			<if test="bean.updateDesc!=null">
				 #{bean.updateDesc},
			</if>
			<if test="bean.updateType!=null">
				 #{bean.updateType},
			</if>
			<if test="bean.status!=null">
				 #{bean.status},
			</if>
			<if test="bean.createTime!=null">
				 #{bean.createTime},
			</if>
			<if test="bean.grayscaleDevice!=null">
				 #{bean.grayscaleDevice},
			</if>
		 </trim>
	</insert>

	<!-- 插入或者更新 （匹配有值的字段）-->
	<insert id="insertOrUpdate" parameterType="com.javastudy.vocabease_common.entity.po.AppUpdate">
		 INSERT INTO app_update
		 <trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="bean.id != null">
				 id,
			</if>
			<if test="bean.version != null">
				 version,
			</if>
			<if test="bean.updateDesc != null">
				 update_desc,
			</if>
			<if test="bean.updateType != null">
				 update_type,
			</if>
			<if test="bean.status != null">
				 status,
			</if>
			<if test="bean.createTime != null">
				 create_time,
			</if>
			<if test="bean.grayscaleDevice != null">
				 grayscale_device,
			</if>
		 </trim>
		 <trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="bean.id!=null">
				 #{bean.id},
			</if>
			<if test="bean.version!=null">
				 #{bean.version},
			</if>
			<if test="bean.updateDesc!=null">
				 #{bean.updateDesc},
			</if>
			<if test="bean.updateType!=null">
				 #{bean.updateType},
			</if>
			<if test="bean.status!=null">
				 #{bean.status},
			</if>
			<if test="bean.createTime!=null">
				 #{bean.createTime},
			</if>
			<if test="bean.grayscaleDevice!=null">
				 #{bean.grayscaleDevice},
			</if>
		 </trim>
		 on DUPLICATE key update 
		 <trim prefix="" suffix="" suffixOverrides=",">
			<if test="bean.version!=null">
				 version = VALUES(version),
			</if>
			<if test="bean.updateDesc!=null">
				 update_desc = VALUES(update_desc),
			</if>
			<if test="bean.updateType!=null">
				 update_type = VALUES(update_type),
			</if>
			<if test="bean.status!=null">
				 status = VALUES(status),
			</if>
			<if test="bean.createTime!=null">
				 create_time = VALUES(create_time),
			</if>
			<if test="bean.grayscaleDevice!=null">
				 grayscale_device = VALUES(grayscale_device),
			</if>
		 </trim>
	</insert>

	<!-- 添加 （批量插入）-->
	<insert id="insertBatch" parameterType="com.javastudy.vocabease_common.entity.po.AppUpdate" useGeneratedKeys="true" keyProperty="id">
		 INSERT INTO app_update(
			 version,
			 update_desc,
			 update_type,
			 status,
			 create_time,
			 grayscale_device
		 )values
		 <foreach collection="list" item="item" separator=",">
			 (
				 #{item.version},
				 #{item.updateDesc},
				 #{item.updateType},
				 #{item.status},
				 #{item.createTime},
				 #{item.grayscaleDevice}
			 )
		 </foreach>
	</insert>

	<!-- 批量新增修改 （批量插入）-->
	<insert id="insertOrUpdateBatch" parameterType="com.javastudy.vocabease_common.entity.po.AppUpdate">
		 INSERT INTO app_update(
			 version,
			 update_desc,
			 update_type,
			 status,
			 create_time,
			 grayscale_device
		 )values
		 <foreach collection="list" item="item" separator=",">
			 (
				 #{item.version},
				 #{item.updateDesc},
				 #{item.updateType},
				 #{item.status},
				 #{item.createTime},
				 #{item.grayscaleDevice}
			 )
		 </foreach>
			on DUPLICATE key update 
			version = VALUES(version),
			update_desc = VALUES(update_desc),
			update_type = VALUES(update_type),
			status = VALUES(status),
			create_time = VALUES(create_time),
			grayscale_device = VALUES(grayscale_device)
	</insert>

	<!--多条件修改-->
	<update id="updateByParam" parameterType="com.javastudy.vocabease_common.entity.query.AppUpdateQuery">
		 UPDATE app_update a
 		 <set> 
			<if test="bean.version != null">
				 version = #{bean.version},
			</if>
			<if test="bean.updateDesc != null">
				 update_desc = #{bean.updateDesc},
			</if>
			<if test="bean.updateType != null">
				 update_type = #{bean.updateType},
			</if>
			<if test="bean.status != null">
				 status = #{bean.status},
			</if>
			<if test="bean.createTime != null">
				 create_time = #{bean.createTime},
			</if>
			<if test="bean.grayscaleDevice != null">
				 grayscale_device = #{bean.grayscaleDevice},
			</if>
 		 </set>
 		 <include refid="query_condition" />
	</update>

	<!--多条件删除-->
	<delete id="deleteByParam">
		 delete a from app_update a
 		 <include refid="query_condition" />
	</delete>

	<!-- 根据Id修改-->
	<update id="updateById" parameterType="com.javastudy.vocabease_common.entity.po.AppUpdate">
		 UPDATE app_update
 		 <set> 
			<if test="bean.version != null">
				 version = #{bean.version},
			</if>
			<if test="bean.updateDesc != null">
				 update_desc = #{bean.updateDesc},
			</if>
			<if test="bean.updateType != null">
				 update_type = #{bean.updateType},
			</if>
			<if test="bean.status != null">
				 status = #{bean.status},
			</if>
			<if test="bean.createTime != null">
				 create_time = #{bean.createTime},
			</if>
			<if test="bean.grayscaleDevice != null">
				 grayscale_device = #{bean.grayscaleDevice},
			</if>
 		 </set>
 		 where id=#{id}
	</update>

	<!-- 根据Id删除-->
	<delete id="deleteById">
		delete from app_update where id=#{id}
	</delete>

	<!-- 根据PrimaryKey获取对象-->
	<select id="selectById" resultMap="base_result_map" >
		select <include refid="base_column_list" /> from app_update a where id=#{id}
	</select>

	<select id="selectLastUpdate" resultMap="base_result_map" >
		select <include refid="base_column_list" />
		    from app_update a where version>#{version}
		    and (status=2 or (status=1 and find_in_set(#{deviceId},grayscale_device)))
			order by id desc limit 0,1
	</select>
</mapper>