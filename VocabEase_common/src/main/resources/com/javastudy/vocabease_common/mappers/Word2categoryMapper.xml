<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javastudy.vocabease_common.mappers.Word2categoryMapper">

	<!--实体映射-->
	<resultMap id="base_result_map" type="com.javastudy.vocabease_common.entity.po.Word2category">
		<!--单词id-->
		<result column="word_id" property="wordId"  />
		<!--分类id-->
		<result column="category_id" property="categoryId"  />
	</resultMap>


	<!-- 通用查询结果列-->
	<sql id="base_column_list">
		 w.word_id,w.category_id
	</sql>

	<sql id="base_condition_filed">
			<if test="query.wordId != null">
				 and  w.word_id = #{query.wordId}
			</if>
			<if test="query.categoryId != null">
				 and  w.category_id = #{query.categoryId}
			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
	 </where>
	</sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map" >
		 SELECT <include refid="base_column_list" /> FROM word2category w <include refid="query_condition" />
		 <if test="query.orderBy!=null">
			 order by ${query.orderBy}
		 </if>
		 <if test="query.simplePage!=null">
			 limit #{query.simplePage.start},#{query.simplePage.end}
		 </if>
	</select>

	<!-- 查询数量-->
	<select id="selectCount" resultType="java.lang.Integer" >
		 SELECT count(1) FROM word2category w <include refid="query_condition" />
	</select>

	<!-- 查询分类id-->
	<select id="selectCategoryIdByWordId" resultType="java.lang.Integer" >
		SELECT category_id FROM word2category a <include refid="query_condition" />
	</select>

	<!-- 插入 （匹配有值的字段）-->
	<insert id="insert" parameterType="com.javastudy.vocabease_common.entity.po.Word2category">
		 INSERT INTO word2category
		 <trim prefix="(" suffix=")" suffixOverrides="," >
			<if test="bean.wordId != null">
				 word_id,
			</if>
			<if test="bean.categoryId != null">
				 category_id,
			</if>
		 </trim>
		 <trim prefix="values (" suffix=")" suffixOverrides="," >
			<if test="bean.wordId!=null">
				 #{bean.wordId},
			</if>
			<if test="bean.categoryId!=null">
				 #{bean.categoryId},
			</if>
		 </trim>
	</insert>

	<!-- 插入或者更新 （匹配有值的字段）-->
	<insert id="insertOrUpdate" parameterType="com.javastudy.vocabease_common.entity.po.Word2category">
		 INSERT INTO word2category
		 <trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="bean.wordId != null">
				 word_id,
			</if>
			<if test="bean.categoryId != null">
				 category_id,
			</if>
		 </trim>
		 <trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="bean.wordId!=null">
				 #{bean.wordId},
			</if>
			<if test="bean.categoryId!=null">
				 #{bean.categoryId},
			</if>
		 </trim>
		 on DUPLICATE key update 
		 <trim prefix="" suffix="" suffixOverrides=",">
			<if test="bean.wordId!=null">
				 word_id = VALUES(word_id),
			</if>
			<if test="bean.categoryId!=null">
				 category_id = VALUES(category_id),
			</if>
		 </trim>
	</insert>

	<!-- 添加 （批量插入）-->
	<insert id="insertBatch" parameterType="com.javastudy.vocabease_common.entity.po.Word2category">
		 INSERT INTO word2category(
			 word_id,
			 category_id
		 )values
		 <foreach collection="list" item="item" separator=",">
			 (
				 #{item.wordId},
				 #{item.categoryId}
			 )
		 </foreach>
	</insert>

	<!-- 批量新增修改 （批量插入）-->
	<insert id="insertOrUpdateBatch" parameterType="com.javastudy.vocabease_common.entity.po.Word2category">
		 INSERT INTO word2category(
			 word_id,
			 category_id
		 )values
		 <foreach collection="list" item="item" separator=",">
			 (
				 #{item.wordId},
				 #{item.categoryId}
			 )
		 </foreach>
			on DUPLICATE key update 
			word_id = VALUES(word_id),
			category_id = VALUES(category_id)
	</insert>

	<!--多条件修改-->
	<update id="updateByParam" parameterType="com.javastudy.vocabease_common.entity.query.Word2categoryQuery">
		 UPDATE word2category w
 		 <set> 
			<if test="bean.wordId != null">
				 word_id = #{bean.wordId},
			</if>
			<if test="bean.categoryId != null">
				 category_id = #{bean.categoryId},
			</if>
 		 </set>
 		 <include refid="query_condition" />
	</update>

	<!--多条件删除-->
	<delete id="deleteByParam">
		 delete w from word2category w
 		 <include refid="query_condition" />
	</delete>

	<!-- 根据WordIdAndCategoryId修改-->
	<update id="updateByWordIdAndCategoryId" parameterType="com.javastudy.vocabease_common.entity.po.Word2category">
		 UPDATE word2category
 		 <set> 
 		 </set>
 		 where word_id=#{wordId} and category_id=#{categoryId}
	</update>

	<!-- 根据WordIdAndCategoryId删除-->
	<delete id="deleteByWordIdAndCategoryId">
		delete from word2category where word_id=#{wordId} and category_id=#{categoryId}
	</delete>

	<!-- 根据WordIds删除多个对象-->
	<delete id="deleteByWordIds">
		delete from word2category where word_id in
		<foreach collection="wordIds" separator="," item="item">#{item}</foreach>
	</delete>

	<!-- 根据PrimaryKey获取对象-->
	<select id="selectByWordIdAndCategoryId" resultMap="base_result_map" >
		select <include refid="base_column_list" /> from word2category w where word_id=#{wordId} and category_id=#{categoryId}
	</select>

</mapper>