	<!-- 添加 （批量插入）-->
	<insert id="insertBatch" parameterType="com.javastudy.vocabease_common.entity.po.AppCarousel" useGeneratedKeys="true" keyProperty="carouselId">
		 INSERT INTO app_carousel(
			 imag_path,
			 object_type,
			 object_id,
			 outer_link,
			 sort
		 )values
