			</if>
			<if test="bean.objectType != null">
				 object_type,
			</if>
			<if test="bean.objectId != null">
				 object_id,
			</if>
			<if test="bean.outerLink != null">
				 outer_link,
			</if>
			<if test="bean.sort != null">
				 sort,
			</if>
		 </trim>
		 <trim prefix="values (" suffix=")" suffixOverrides="," >
			<if test="bean.imagPath!=null">
				 #{bean.imagPath},
			</if>
			<if test="bean.objectType!=null">
				 #{bean.objectType},
			</if>
			<if test="bean.objectId!=null">
				 #{bean.objectId},
			</if>
			<if test="bean.outerLink!=null">
				 #{bean.outerLink},
			</if>
			<if test="bean.sort!=null">
