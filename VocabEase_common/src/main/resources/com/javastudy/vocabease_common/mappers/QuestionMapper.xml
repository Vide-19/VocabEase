<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javastudy.vocabease_common.mappers.QuestionMapper">

	<!--实体映射-->
	<resultMap id="base_result_map" type="com.javastudy.vocabease_common.entity.po.Question">
		<!--问题id-->
		<id column="question_id" property="questionId"  />
		<!--标题-->
		<result column="title" property="title"  />
		<!--问题描述-->
		<result column="question" property="question"  />
		<!--答案-->
		<result column="answer" property="answer"  />
		<!--答案解释-->
		<result column="answer_analysis" property="answerAnalysis"  />
		<!--等级-->
		<result column="level" property="level"  />
		<!--创建时间-->
		<result column="create_time" property="createTime"  />
		<!--状态 0未发布 1已发布-->
		<result column="status" property="status"  />
		<!--作者id-->
		<result column="creater_id" property="createrId"  />
		<!--浏览量-->
		<result column="read_count" property="readCount"  />
		<!--收藏数-->
		<result column="collect_count" property="collectCount"  />
		<!--发布类别 0内部 1外部-->
		<result column="post_type" property="postType"  />
		<!--问题类型 0判断 1单选 2多选 3填空-->
		<result column="question_type" property="questionType"  />
	</resultMap>

	<!-- 通用查询结果列-->
	<sql id="base_column_list">
		 q.question_id,q.title,q.question,q.level,
		 q.create_time,q.status,q.creater_id,q.read_count,q.collect_count,
		 q.post_type,q.question_type
	</sql>

	<sql id="base_condition_filed">
        <if test="query.questionId != null">
            and q.question_id = #{query.questionId}
        </if>
        <if test="query.title != null and query.title!=''">
            and q.title = #{query.title}
        </if>
        <if test="query.question != null and query.question!=''">
            and q.question = #{query.question}
        </if>
        <if test="query.answer != null and query.answer!=''">
            and q.answer = #{query.answer}
        </if>
        <if test="query.answerAnalysis != null and query.answerAnalysis!=''">
            and q.answer_analysis = #{query.answerAnalysis}
        </if>
        <if test="query.level != null">
            and q.level = #{query.level}
        </if>
        <if test="query.createTime != null and query.createTime!=''">
            <![CDATA[ and  q.create_time=str_to_date(#{query.createTime}, '%Y-%m-%d') ]]>
        </if>
        <if test="query.status != null">
            and q.status = #{query.status}
        </if>
        <if test="query.createrId != null and query.createrId!=''">
            and q.creater_id = #{query.createrId}
        </if>
        <if test="query.readCount != null">
            and q.read_count = #{query.readCount}
        </if>
        <if test="query.collectCount != null">
            and q.collect_count = #{query.collectCount}
        </if>
        <if test="query.postType != null">
            and q.post_type = #{query.postType}
        </if>
        <if test="query.questionType != null">
            and q.question_type = #{query.questionType}
        </if>
    </sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
        <where>
            <include refid="base_condition_filed"/>
            <if test="query.titleFuzzy!= null  and query.titleFuzzy!=''">
                and q.title like concat('%', #{query.titleFuzzy}, '%')
            </if>
            <if test="query.questionFuzzy!= null  and query.questionFuzzy!=''">
                and q.question like concat('%', #{query.questionFuzzy}, '%')
            </if>
			<if test="query.answerFuzzy!= null  and query.answerFuzzy!=''">
				and q.answer like concat('%', #{query.answerFuzzy}, '%')
			</if>
            <if test="query.answerAnalysisFuzzy!= null  and query.answerAnalysisFuzzy!=''">
                and q.answer_analysis like concat('%', #{query.answerAnalysisFuzzy}, '%')
            </if>
            <if test="query.createTimeStart!= null and query.createTimeStart!=''">
                <![CDATA[ and  q.create_time>=str_to_date(#{query.createTimeStart}, '%Y-%m-%d') ]]>
            </if>
            <if test="query.createTimeEnd!= null and query.createTimeEnd!=''">
                <![CDATA[ and  q.create_time< date_sub(str_to_date(#{query.createTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
            </if>
            <if test="query.createrIdFuzzy!= null  and query.createrIdFuzzy!=''">
                and q.creater_id like concat('%', #{query.createrIdFuzzy}, '%')
            </if>
            <if test="query.questionIds!=null and query.questionIds.length>0">
                and question_id in (
                <foreach collection="query.questionIds" separator="," item="item">#{item}</foreach>)
            </if>
            <if test="query.nextType!=null and query.nextType==1 and query.currentId!=null">
                <![CDATA[ and question_id<#{query.currentId} order by question_id desc ]]>
            </if>
            <if test="query.nextType!=null and query.nextType==-1 and query.currentId!=null">
                <![CDATA[ and question_id>#{query.currentId} order by question_id asc ]]>
            </if>
        </where>
    </sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map" >
		 SELECT <include refid="base_column_list" />
		 <if test="query.isQueryAnswer!=null and query.isQueryAnswer">
			,answer,answer_analysis
		 </if>
		 FROM question q <include refid="query_condition" />
		 <if test="query.orderBy!=null">
			 order by ${query.orderBy}
		 </if>
		 <if test="query.simplePage!=null">
			 limit #{query.simplePage.start},#{query.simplePage.end}
		 </if>
	</select>

	<!-- 查询数量-->
	<select id="selectCount" resultType="java.lang.Integer" >
		 SELECT count(1) FROM question q <include refid="query_condition" />
	</select>

	<!-- 插入 （匹配有值的字段）-->
	<insert id="insert" parameterType="com.javastudy.vocabease_common.entity.po.Question">
		<selectKey keyProperty="bean.questionId" resultType="Integer" order="AFTER">
			SELECT LAST_INSERT_ID()
		</selectKey>
		 INSERT INTO question
		 <trim prefix="(" suffix=")" suffixOverrides="," >
			<if test="bean.title != null">
				 title,
			</if>
			<if test="bean.question != null">
				 question,
			</if>
			 <if test="bean.answer != null">
				 answer,
			 </if>
			<if test="bean.answerAnalysis != null">
				 answer_analysis,
			</if>
			<if test="bean.level != null">
				 level,
			</if>
			<if test="bean.createTime != null">
				 create_time,
			</if>
			<if test="bean.status != null">
				 status,
			</if>
			<if test="bean.createrId != null">
				 creater_id,
			</if>
			<if test="bean.readCount != null">
				 read_count,
			</if>
			<if test="bean.collectCount != null">
				 collect_count,
			</if>
			<if test="bean.postType != null">
				 post_type,
			</if>
			<if test="bean.questionType != null">
				 question_type,
			</if>
		 </trim>
		 <trim prefix="values (" suffix=")" suffixOverrides="," >
			<if test="bean.title!=null">
				 #{bean.title},
			</if>
			<if test="bean.question!=null">
				 #{bean.question},
			</if>
			 <if test="bean.answer!=null">
				 #{bean.answer},
			 </if>
			<if test="bean.answerAnalysis!=null">
				 #{bean.answerAnalysis},
			</if>
			<if test="bean.level!=null">
				 #{bean.level},
			</if>
			<if test="bean.createTime!=null">
				 #{bean.createTime},
			</if>
			<if test="bean.status!=null">
				 #{bean.status},
			</if>
			<if test="bean.createrId!=null">
				 #{bean.createrId},
			</if>
			<if test="bean.readCount!=null">
				 #{bean.readCount},
			</if>
			<if test="bean.collectCount!=null">
				 #{bean.collectCount},
			</if>
			<if test="bean.postType!=null">
				 #{bean.postType},
			</if>
			<if test="bean.questionType!=null">
				 #{bean.questionType},
			</if>
		 </trim>
	</insert>

