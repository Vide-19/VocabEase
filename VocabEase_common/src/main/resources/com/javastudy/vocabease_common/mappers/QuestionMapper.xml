            </if>
            <if test="bean.postType != null">
                post_type = #{bean.postType},
            </if>
            <if test="bean.questionType != null">
                question_type = #{bean.questionType},
            </if>
        </set>
        <include refid="query_condition"/>
    </update>

	<!--多条件删除-->
	<delete id="deleteByParam">
		 delete q from question q
 		 <include refid="query_condition" />
	</delete>

	<!-- 根据QuestionId修改-->
	<update id="updateByQuestionId" parameterType="com.javastudy.vocabease_common.entity.po.Question">
		 UPDATE question
 		 <set> 
			<if test="bean.title != null">
				 title = #{bean.title},
			</if>
			<if test="bean.question != null">
				 question = #{bean.question},
			</if>
             <if test="bean.answer != null">
                 answer = #{bean.answer},
             </if>
			<if test="bean.answerAnalysis != null">
				 answer_analysis = #{bean.answerAnalysis},
			</if>
			<if test="bean.level != null">
