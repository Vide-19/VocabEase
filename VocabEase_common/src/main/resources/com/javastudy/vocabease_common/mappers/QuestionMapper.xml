    </insert>

	<!--多条件修改-->
	<update id="updateByParam" parameterType="com.javastudy.vocabease_common.entity.query.QuestionQuery">
        UPDATE question q
        <set>
            <if test="bean.title != null">
                title = #{bean.title},
            </if>
            <if test="bean.question != null">
                question = #{bean.question},
            </if>
            <if test="bean.answer != null">
                answer = #{bean.answer},
            </if>
            <if test="bean.answerAnalysis != null">
                answer_analysis = #{bean.answerAnalysis},
            </if>
            <if test="bean.level != null">
                level = #{bean.level},
            </if>
            <if test="bean.createTime != null">
                create_time = #{bean.createTime},
            </if>
            <if test="bean.status != null">
                status = #{bean.status},
            </if>
