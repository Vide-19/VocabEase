			</if>
 		 </set>
 		 where question_id=#{questionId}
	</update>

	<!-- 根据QuestionId删除-->
	<delete id="deleteByQuestionId">
		delete from question where question_id=#{questionId}
	</delete>

	<!-- 根据PrimaryKey获取对象-->
	<select id="selectByQuestionId" resultMap="base_result_map" >
		select <include refid="base_column_list" /> from question q where question_id=#{questionId}
	</select>

	<select id="showQuestionNext" resultMap="base_result_map">
		select * from question
		<include refid="query_condition"/>
		limit 0,1
	</select>

</mapper>